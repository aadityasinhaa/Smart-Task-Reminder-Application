<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base Application Theme -->
    <style name="Theme.SmartTaskReminder" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/primary_500</item>
        <item name="colorPrimaryVariant">@color/primary_700</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/accent_500</item>
        <item name="colorSecondaryVariant">@color/accent_500</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/primary_700</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Background -->
        <item name="android:colorBackground">@color/bg_primary</item>
        <item name="colorSurface">@color/bg_primary</item>
    </style>

    <!-- Splash Theme (fullscreen, different background) -->
    <style name="Theme.SmartTaskReminder.Splash" parent="Theme.SmartTaskReminder">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <!-- Button Style -->
    <style name="Widget.SmartTaskReminder.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="backgroundTint">@color/primary_500</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">@dimen/corner_m</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Outlined Button -->
    <style name="Widget.SmartTaskReminder.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="strokeColor">@color/primary_500</item>
        <item name="android:textColor">@color/primary_500</item>
        <item name="cornerRadius">@dimen/corner_m</item>
    </style>

    <!-- TextInputLayout (Filled Box) -->
    <style name="Widget.SmartTaskReminder.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.FilledBox">
        <item name="boxCornerRadiusTopStart">@dimen/corner_m</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_m</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_m</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_m</item>
        <item name="boxStrokeColor">@color/primary_500</item>
    </style>

    <!-- Filter Chip -->
    <style name="Widget.SmartTaskReminder.FilterChip" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="chipBackgroundColor">@color/bg_secondary</item>
        <item name="chipStrokeColor">@color/primary_500</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="checkedIconTint">@color/primary_500</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Toolbar -->
    <style name="Widget.SmartTaskReminder.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@color/primary_500</item>
        <item name="titleTextColor">@color/white</item>
    </style>

</resources>
